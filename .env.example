# Copy to .env and fill in. Generate the secrets with:
#   openssl rand -hex 24

# Shared password of the internal dovecot backup store.
# Allowed characters: A-Z a-z 0-9 . _ ~ = + / @ : -   (min. 12 chars)
DOVECOT_MASTER_PASSWORD=

# Encrypts the mailbox passwords stored in the local database.
# Leave empty to auto-generate a key file in ./data/app/secret.key.
# If you set it later, previously stored passwords can no longer be decrypted.
SECRET_KEY=

# HTTP basic auth for the web interface. Leave AUTH_USER empty to disable
# (only do that if the port is not reachable from outside the host).
AUTH_USER=admin
AUTH_PASSWORD=

# Port the web interface is published on.
WEB_PORT=8080

# How many imapsync processes run at the same time.
MAX_CONCURRENT_JOBS=2

# IMAP socket timeout in seconds.
IMAP_TIMEOUT=180

# Owner uid/gid of the downloaded mail on the host.
VMAIL_UID=1000
VMAIL_GID=1000

# Timezone used for timestamps in the container.
TZ=Europe/Berlin

# Pinned imapsync release (tag from github.com/imapsync/imapsync).
IMAPSYNC_VERSION=imapsync-2.314
